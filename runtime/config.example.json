{
  "providers": {
    "claude": {"type": "anthropic", "model": "claude-sonnet-5-5", "api_key_env": "ANTHROPIC_API_KEY"},
    "other":  {"type": "openai_compat", "base_url": "https://api.openai.com/v1", "model": "SET_YOUR_MODEL",
               "api_key_env": "OPENAI_API_KEY"},
    "local":  {"type": "openai_compat", "base_url": "http://localhost:11434/v1", "model": "SET_YOUR_MODEL",
               "api_key_env": ""},
    "cli":    {"type": "command", "command": "your-agent-cli --headless-flag", "native_agent": true}
  },
  "roles": {
    "router":   ["claude", "other"],
    "planner":  ["claude", "other"],
    "executor": ["claude", "other", "local"],
    "verifier": ["other", "claude"]
  },
  "resilience": {"max_retries": 5, "base_delay": 2, "max_delay": 60, "outage_wait_seconds": 0},
  "limits": {"max_rounds": 4, "max_tokens": 600000, "max_seconds": 7200, "max_turns": 40,
             "max_context_chars": 150000, "cmd_timeout": 120}
}
